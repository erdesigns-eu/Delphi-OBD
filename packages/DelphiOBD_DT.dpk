package DelphiOBD_DT;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Delphi-OBD component editors'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  vclimg,
  designide,
  DelphiOBD_RT;

contains
  ERD.Design.Registration in '..\src\DesignTime\ERD.Design.Registration.pas',
  ERD.Design.Editors in '..\src\DesignTime\ERD.Design.Editors.pas',
  ERD.Design.Forms.FlashSafety in '..\src\DesignTime\ERD.Design.Forms.FlashSafety.pas' {OBDFlashSafetyDlg},
  ERD.Design.Forms.InitCommands in '..\src\DesignTime\ERD.Design.Forms.InitCommands.pas' {OBDInitCommandsDlg},
  ERD.Design.Forms.PipelineValidate in '..\src\DesignTime\ERD.Design.Forms.PipelineValidate.pas' {OBDPipelineValidateDlg},
  ERD.Design.Forms.LiveTest in '..\src\DesignTime\ERD.Design.Forms.LiveTest.pas' {OBDLiveTestDlg};

end.
