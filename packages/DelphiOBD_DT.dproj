<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{D88313E4-4735-5CDC-A1E7-44F38831253D}</ProjectGuid>
    <ProjectVersion>19.3</ProjectVersion>
    <MainSource>DelphiOBD_DT.dpk</MainSource>
    <AppType>Package</AppType>
    <Config Condition="'$(Config)'==''">Release</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <DCC_Namespace>System;Winapi;Vcl;Data;Xml;$(DCC_Namespace)</DCC_Namespace>
    <DCC_UnitSearchPath>..\src;..\src\Adapter;..\src\Calibration;..\src\Coding;..\src\Collections;..\src\Compat;..\src\Connection;..\src\Core;..\src\DesignTime;..\src\Diagnostics;..\src\Flashing;..\src\OEM;..\src\Protocol;..\src\RadioCode;..\src\Recorder;..\src\Service;..\src\Speciality;..\src\UI;..\src\Utilities;..\build\$(Platform)\$(Config);$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_DcuOutput>..\build\$(Platform)\$(Config)\dt-dcu</DCC_DcuOutput>
    <DCC_DcpOutput>..\build\$(Platform)\$(Config)</DCC_DcpOutput>
    <DCC_BplOutput>$(BDSCOMMONDIR)\Bpl</DCC_BplOutput>
    <DCC_ExeOutput>$(Platform)\$(Config)</DCC_ExeOutput>
    <DCC_Define>$(DCC_Define)</DCC_Define>
    <DCC_AssertionsAtRuntime>true</DCC_AssertionsAtRuntime>
    <FrameworkType>VCL</FrameworkType>
    <Base>True</Base>
    <ProjectName>DelphiOBD_DT</ProjectName>
    <TargetedPlatforms>1</TargetedPlatforms>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
    <Base_Win32>true</Base_Win32>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
    <Cfg_1>true</Cfg_1>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Cfg_1)'=='true') or '$(Cfg_1_Win32)'!=''">
    <Cfg_1_Win32>true</Cfg_1_Win32>
    <CfgParent>Cfg_1</CfgParent>
    <Cfg_1>true</Cfg_1>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
    <Cfg_2>true</Cfg_2>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Cfg_2)'=='true') or '$(Cfg_2_Win32)'!=''">
    <Cfg_2_Win32>true</Cfg_2_Win32>
    <CfgParent>Cfg_2</CfgParent>
    <Cfg_2>true</Cfg_2>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_2)'!=''">
    <DCC_DebugInformation>0</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
    <DCC_Optimize>true</DCC_Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_1)'!=''">
    <DCC_DebugInformation>2</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
    <DCC_Optimize>false</DCC_Optimize>
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="..\src\DesignTime\ERD.Design.Registration.pas" />
    <DCCReference Include="..\src\DesignTime\ERD.Design.Editors.pas" />
    <DCCReference Include="..\src\DesignTime\ERD.Design.Forms.FlashSafety.pas">
      <Form>OBDFlashSafetyDlg</Form>
      <FormType>dfm</FormType>
    </DCCReference>
    <DCCReference Include="..\src\DesignTime\ERD.Design.Forms.InitCommands.pas">
      <Form>OBDInitCommandsDlg</Form>
      <FormType>dfm</FormType>
    </DCCReference>
    <DCCReference Include="..\src\DesignTime\ERD.Design.Forms.PipelineValidate.pas">
      <Form>OBDPipelineValidateDlg</Form>
      <FormType>dfm</FormType>
    </DCCReference>
    <DCCReference Include="..\src\DesignTime\ERD.Design.Forms.LiveTest.pas">
      <Form>OBDLiveTestDlg</Form>
      <FormType>dfm</FormType>
    </DCCReference>
    <BuildConfiguration Include="Base">
      <Key>Base</Key>
    </BuildConfiguration>
    <BuildConfiguration Include="Debug">
      <Key>Cfg_1</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
    <BuildConfiguration Include="Release">
      <Key>Cfg_2</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <Borland.ProjectType>Package</Borland.ProjectType>
    <BorlandProject>
      <Delphi.Personality>
        <Source>
          <Source Name="MainSource">DelphiOBD_DT.dpk</Source>
        </Source>
      </Delphi.Personality>
      <Platforms>
        <Platform value="Win32">True</Platform>
        <Platform value="Win64">False</Platform>
      </Platforms>
    </BorlandProject>
    <ProjectFileVersion>12</ProjectFileVersion>
  </ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" />
</Project>
