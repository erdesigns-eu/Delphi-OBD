<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{D88313E4-4735-5CDC-A1E7-44F38831253D}</ProjectGuid>
    <ProjectVersion>19.3</ProjectVersion>
    <MainSource>DelphiOBD_DT.dpk</MainSource>
    <AppType>Package</AppType>
    <Config Condition="'$(Config)'==''">Release</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <DCC_Namespace>System;Winapi;Vcl;Data;Xml;$(DCC_Namespace)</DCC_Namespace>
    <DCC_UnitSearchPath>..\src;..\src\Adapter;..\src\Calibration;..\src\Coding;..\src\Collections;..\src\Compat;..\src\Connection;..\src\Core;..\src\DesignTime;..\src\Diagnostics;..\src\Flashing;..\src\OEM;..\src\Protocol;..\src\RadioCode;..\src\Recorder;..\src\Service;..\src\Speciality;..\src\UI;..\src\Utilities;..\build\$(Platform)\$(Config);$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_DcuOutput>..\build\$(Platform)\$(Config)\dt-dcu</DCC_DcuOutput>
    <DCC_DcpOutput>..\build\$(Platform)\$(Config)</DCC_DcpOutput>
    <DCC_BplOutput>..\build\$(Platform)\$(Config)</DCC_BplOutput>
    <DCC_ExeOutput>$(Platform)\$(Config)</DCC_ExeOutput>
    <DCC_Define>$(DCC_Define)</DCC_Define>
    <DCC_AssertionsAtRuntime>true</DCC_AssertionsAtRuntime>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release'">
    <DCC_DebugInformation>false</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
    <DCC_Optimize>true</DCC_Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug'">
    <DCC_DebugInformation>true</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
    <DCC_Optimize>false</DCC_Optimize>
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <ItemGroup>
