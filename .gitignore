#-------------------------------------------------------------------------------
#  .gitignore — Delphi-OBD
#
#  RAD Studio per-developer / per-version artefacts and build outputs are
#  not committed. Source and the three reproducible CI projects are tracked.
#-------------------------------------------------------------------------------

# RAD Studio project files (regenerated per developer / per version)
*.dproj
!packages/DelphiOBD_RT.dproj
!packages/DelphiOBD_DT.dproj
!tests/DelphiOBD_Tests.dproj
*.groupproj
*.identcache
*.local
*.projdata
*.tvsconfig
*.skincfg
__history/
__recovery/

# Build outputs
Win32/
Win64/
OSX64/
Android/
Android64/
iOSDevice32/
iOSDevice64/
iOSSimulator/
Linux64/
*.dcu
*.dcp
*.dcpil
*.bpl
*.exe
*.dll
*.lib
*.o
*.obj
*.map
*.drc
*.tds
*.~*
*.tmp
*.bak

# Coverage output
tools/coverage/output/
*.coverage

# IDE caches
*.cfg
*.dof

# OS / editor
Thumbs.db
.DS_Store
*.swp
*~
.vscode/
.idea/

# Secrets — never commit API keys, .env files, or credentials.
.env
.env.*
.secrets/
*.key
*.pem
openai.key

# Python validation tool caches
__pycache__/

# Reproducible local Delphi output and test reports
/build/
/tests/nunit-*.xml
