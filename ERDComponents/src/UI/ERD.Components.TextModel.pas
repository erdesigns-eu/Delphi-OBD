function RangeKind(AScalar: Cardinal; const ARanges: array of TERDUnicodeRange): Byte;
var L, H, M: Integer;
begin
  L := 0; H := High(ARanges);
  while L <= H do
  begin
    M := L + (H - L) div 2;
    if AScalar < ARanges[M].First then H := M - 1
    else if AScalar > ARanges[M].Last then L := M + 1
    else Exit(ARanges[M].Kind);
  end;
  Result := 0;
end;
function ReadScalar(const S: UnicodeString; var I: Integer): Cardinal;
var C: Cardinal;
begin
  Result := Ord(S[I + 1]); Inc(I);
  if (Result >= $D800) and (Result <= $DBFF) and (I < Length(S)) then
  begin
    C := Ord(S[I + 1]);
    if (C >= $DC00) and (C <= $DFFF) then
    begin Result := $10000 + (Result - $D800) * $400 + C - $DC00; Inc(I); end;
  end;
end;
function ERDValidUnicode(const AText: UnicodeString): UnicodeString;
var I, Start: Integer; C: Cardinal;
begin
  Result := AText; I := 0;
  while I < Length(AText) do
  begin
    Start := I; C := ReadScalar(AText, I);
    if (C >= $D800) and (C <= $DFFF) then Result[Start + 1] := WideChar($FFFD);
  end;
end;
function ERDGraphemeBoundaries(const AText: UnicodeString): TArray<Integer>;
var
  Scalars: TArray<Cardinal>;
  Offsets: TArray<Integer>;
  Kinds, Indic: TArray<Byte>;
  I, N, J, Count, RI: Integer;
  BreakHere, Linker: Boolean;
  A, B: Byte;
begin
  N := 0; I := 0;
  SetLength(Scalars, Length(AText)); SetLength(Offsets, Length(AText));
  SetLength(Kinds, Length(AText)); SetLength(Indic, Length(AText));
  while I < Length(AText) do
  begin
    Offsets[N] := I; Scalars[N] := ReadScalar(AText, I);
    Kinds[N] := RangeKind(Scalars[N], GraphemeRanges);
    Indic[N] := RangeKind(Scalars[N], IndicRanges); Inc(N);
  end;
  SetLength(Result, N + 1); Result[0] := 0; Count := 1;
  for I := 1 to N - 1 do
  begin
    A := Kinds[I - 1]; B := Kinds[I]; BreakHere := True;
    if (A = 1) and (B = 2) then BreakHere := False // GB3 CR LF
    else if (A in [1,2,3]) or (B in [1,2,3]) then BreakHere := True
    else if (A = 9) and (B in [9,10,12,13]) then BreakHere := False
    else if (A in [10,12]) and (B in [10,11]) then BreakHere := False
    else if (A in [11,13]) and (B = 11) then BreakHere := False
    else if (B in [4,5,8]) or (A = 7) then BreakHere := False
    else
    begin
      // GB9c: Indic consonant + extends/linkers + consonant.
      if Indic[I] = 1 then
      begin
        J := I - 1; Linker := False;
        while (J >= 0) and (Indic[J] in [2,3]) do
        begin Linker := Linker or (Indic[J] = 3); Dec(J); end;
        if Linker and (J >= 0) and (Indic[J] = 1) then BreakHere := False;
      end;
      // GB11: Extended_Pictographic Extend* ZWJ Extended_Pictographic.
      if BreakHere and (A = 5) and (RangeKind(Scalars[I], PictographicRanges) <> 0) then
      begin
        J := I - 2;
        while (J >= 0) and (Kinds[J] = 4) do Dec(J);
        if (J >= 0) and (RangeKind(Scalars[J], PictographicRanges) <> 0) then BreakHere := False;
      end;
      if BreakHere and (A = 6) and (B = 6) then
      begin
        RI := 0; J := I - 1;
        while (J >= 0) and (Kinds[J] = 6) do begin Inc(RI); Dec(J); end;
        BreakHere := not Odd(RI);
      end;
    end;
    if BreakHere then begin Result[Count] := Offsets[I]; Inc(Count); end;
  end;
  if N > 0 then begin Result[Count] := Length(AText); Inc(Count); end;
  SetLength(Result, Count);
end;
constructor TERDTextModel.Create;
begin
  inherited;
  FUndo := TList<TERDTextSnapshot>.Create;
  FRedo := TList<TERDTextSnapshot>.Create;
  Rebuild;
end;
destructor TERDTextModel.Destroy;
begin FRedo.Free; FUndo.Free; inherited; end;
procedure TERDTextModel.Rebuild;
begin FBoundaries := ERDGraphemeBoundaries(FText); end;
function TERDTextModel.Snapshot: TERDTextSnapshot;
begin Result.Text := FText; Result.Anchor := FAnchor; Result.Caret := FCaret; end;
procedure TERDTextModel.Restore(const AValue: TERDTextSnapshot);
begin FText := AValue.Text; Rebuild; Select(AValue.Anchor, AValue.Caret); end;
procedure TERDTextModel.Remember;
begin
  if FUndo.Count = 128 then FUndo.Delete(0);
  FUndo.Add(Snapshot); FRedo.Clear;
end;
procedure TERDTextModel.SetText(const AValue: UnicodeString);
begin
  FText := ERDValidUnicode(AValue); Rebuild;
  Select(Length(FText), Length(FText)); FUndo.Clear; FRedo.Clear;
end;
function TERDTextModel.Snap(APosition: Integer): Integer;
var L, H, M: Integer;
begin
  APosition := EnsureRange(APosition, 0, Length(FText));
  L := 0; H := High(FBoundaries);
  while L < H do
  begin
    M := L + (H - L + 1) div 2;
    if FBoundaries[M] <= APosition then L := M else H := M - 1;
  end;
  Result := FBoundaries[L];
end;
function TERDTextModel.Previous(APosition: Integer): Integer;
begin Result := Snap(Max(0, APosition - 1)); end;
function TERDTextModel.Next(APosition: Integer): Integer;
var B: Integer;
begin
  for B in FBoundaries do if B > APosition then Exit(B);
  Result := Length(FText);
end;
function TERDTextModel.WordKind(APosition: Integer): Byte;
var C: Cardinal; I: Integer;
begin
  if APosition >= Length(FText) then Exit(0);
  I := Snap(APosition); C := ReadScalar(FText, I);
  if (C <= $20) or (C = $85) or (C = $A0) or (C = $1680) or
    ((C >= $2000) and (C <= $200A)) or (C = $2028) or (C = $2029) or
    (C = $202F) or (C = $205F) or (C = $3000) then Exit(0);
  if ((C >= $21) and (C <= $2F)) or ((C >= $3A) and (C <= $40)) or
    ((C >= $5B) and (C <= $60)) or ((C >= $7B) and (C <= $7E)) then Exit(2);
  Result := 1;
end;
function TERDTextModel.PreviousWord(APosition: Integer): Integer;
var Kind: Byte;
begin
  Result := Snap(APosition);
  while (Result > 0) and (WordKind(Previous(Result)) = 0) do Result := Previous(Result);
  if Result = 0 then Exit;
  Kind := WordKind(Previous(Result));
  while (Result > 0) and (WordKind(Previous(Result)) = Kind) do Result := Previous(Result);
end;
function TERDTextModel.NextWord(APosition: Integer): Integer;
var Kind: Byte;
begin
  Result := Snap(APosition); Kind := WordKind(Result);
  while (Result < Length(FText)) and (WordKind(Result) = Kind) do Result := Next(Result);
  while (Result < Length(FText)) and (WordKind(Result) = 0) do Result := Next(Result);
end;
procedure TERDTextModel.Select(AAnchor, ACaret: Integer);
begin FAnchor := Snap(AAnchor); FCaret := Snap(ACaret); end;
function TERDTextModel.GetSelStart: Integer;
begin Result := Min(FAnchor, FCaret); end;
function TERDTextModel.GetSelLength: Integer;
begin Result := Abs(FAnchor - FCaret); end;
procedure TERDTextModel.ReplaceSelection(const AValue: UnicodeString; AMaxLength: Integer);
var S, NewText: UnicodeString; B, Limit, Cut, Start: Integer;
begin
  S := ERDValidUnicode(AValue); Start := SelStart;
  if AMaxLength > 0 then
  begin
    Limit := Max(0, AMaxLength - Length(FText) + SelLength); Cut := 0;
    for B in ERDGraphemeBoundaries(S) do if B <= Limit then Cut := B;
    S := Copy(S, 1, Cut);
  end;
  NewText := Copy(FText, 1, Start) + S + Copy(FText, Start + SelLength + 1, MaxInt);
  if NewText = FText then Exit;
  Remember; FText := NewText; Rebuild;
  Cut := Start + Length(S);
  // A pasted combining mark/ZWJ can join the cluster on either side.
  if Snap(Cut) <> Cut then Cut := Next(Cut);
  Select(Cut, Cut);
end;
procedure TERDTextModel.ReplaceRange(Start, Count: Integer; const Value: UnicodeString);
var Before: TERDTextSnapshot; Finish: Integer;
begin
  Before := Snapshot; Start := EnsureRange(Start, 0, Length(FText));
  Finish := Start + Min(Max(0, Count), Length(FText) - Start);
  if Snap(Finish) <> Finish then Finish := Next(Finish);
  Select(Start, Finish); ReplaceSelection(Value);
  if Before.Text = FText then Select(Before.Anchor, Before.Caret)
  else FUndo[FUndo.Count - 1] := Before;
end;
procedure TERDTextModel.DeleteBackward;
begin
  if SelLength = 0 then Select(Previous(FCaret), FCaret);
  ReplaceSelection('');
end;
procedure TERDTextModel.DeleteForward;
begin
  if SelLength = 0 then Select(FCaret, Next(FCaret));
  ReplaceSelection('');
end;
function TERDTextModel.GetCanUndo: Boolean;
begin Result := FUndo.Count > 0; end;
function TERDTextModel.GetCanRedo: Boolean;
begin Result := FRedo.Count > 0; end;
procedure TERDTextModel.ClearUndo;
begin FUndo.Clear; FRedo.Clear; end;
procedure TERDTextModel.Undo;
var S: TERDTextSnapshot;
begin
  if FUndo.Count = 0 then Exit;
  FRedo.Add(Snapshot); S := FUndo.Last; FUndo.Delete(FUndo.Count - 1); Restore(S);
end;
procedure TERDTextModel.Redo;
var S: TERDTextSnapshot;
begin
  if FRedo.Count = 0 then Exit;
  FUndo.Add(Snapshot); S := FRedo.Last; FRedo.Delete(FRedo.Count - 1); Restore(S);
end;
end.
