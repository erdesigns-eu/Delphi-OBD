      "description": "CVVD Camshaft Position Performance (HMG Smartstream)",
      "possible_causes": [
        "Sensor / actuator failure",
        "Wiring fault",
        "Module driver failure"
      ],
      "verified": false,
      "symptoms": [
        "MIL on",
        "Possible drivability impact"
      ],
      "repair_guidance": [
        "1) Run live data: target vs actual cam advance per bank.",
        "2) Check engine oil quality and level — VVT solenoids fail with old/dirty oil.",
        "3) Inspect VVT solenoid screen for debris.",
        "4) Replace solenoid; if mechanical (timing chain wear), open inspection."
      ],
      "monitor_type": "continuous",
      "freeze_frame_relevant": true,
      "related_dids": [],
      "related_routines": [],
      "oem_bulletin": ""
    },
