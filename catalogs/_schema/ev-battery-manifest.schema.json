{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erdesigns.eu/schema/ev-battery-manifest.json",
  "title": "EV battery catalog manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "generated",
    "vendor_files",
    "all_sources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifest_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "all_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vendor_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vendor",
          "file",
          "coverage",
          "primary_source"
        ],
        "properties": {
          "vendor": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*\\.json$"
          },
          "coverage": {
            "type": "string",
            "minLength": 1
          },
          "primary_source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
