{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erdesigns.eu/schema/oem-overlay.json",
  "title": "oem-overlay",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "oem"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "spec": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "oem": {
      "type": "string"
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "dids": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:0x)?[0-9A-Fa-f]+$"
          },
          "name": {
            "type": "string"
          },
          "length": {
            "type": "integer",
            "minimum": 0
          },
          "unit": {
            "type": "string"
          },
          "decoder": {
            "type": "string"
          },
          "scale": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "pids": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:0x)?[0-9A-Fa-f]+$"
          },
          "name": {
            "type": "string"
          },
          "length": {
            "type": "integer",
            "minimum": 0
          },
          "unit": {
            "type": "string"
          },
          "decoder": {
            "type": "string"
          },
          "scale": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "dtcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "description"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "possible_causes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "symptoms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "repair_guidance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "monitor_type": {
            "type": "string"
          },
          "freeze_frame_relevant": {
            "type": "boolean"
          },
          "related_dids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related_routines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "oem_bulletin": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
