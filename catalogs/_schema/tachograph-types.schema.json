{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erdesigns.eu/schema/tachograph-types.json",
  "title": "tachograph-types",
  "type": "object",
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "spec": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "oem": {
      "type": "string"
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "records": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "tag",
          "size",
          "encoding"
        ],
        "properties": {
          "tag": {
            "type": "string",
            "pattern": "^(?:0x)?[0-9A-Fa-f]+$"
          },
          "size": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "string"
              }
            ]
          },
          "encoding": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "bits": {
                  "type": "string"
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "size": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "encoding": {
                  "type": "string"
                },
                "values": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "unit": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "notes": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "notes": {
            "type": "string"
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "fields"
            ]
          },
          {
            "required": [
              "values"
            ]
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
