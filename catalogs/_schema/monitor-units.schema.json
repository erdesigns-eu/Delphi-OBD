{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erdesigns.eu/schema/monitor-units.json",
  "type": "object",
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "spec": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ucsid",
          "unit",
          "scale"
        ],
        "properties": {
          "ucsid": {
            "type": "string",
            "pattern": "^0x[0-9A-Fa-f]{2}$"
          },
          "unit": {
            "type": "string"
          },
          "scale": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
