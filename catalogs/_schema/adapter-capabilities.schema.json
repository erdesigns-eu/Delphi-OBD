{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erdesigns.eu/schema/adapter-capabilities.json",
  "title": "adapter-capabilities",
  "type": "object",
  "required": [
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "spec": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "oem": {
      "type": "string"
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "capability_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "adapter_key",
          "capabilities"
        ],
        "properties": {
          "adapter_key": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "max_iso_tp_frame_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "connection_interfaces": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "chipset": {
            "type": [
              "string",
              "null"
            ]
          },
          "firmware_family": {
            "type": [
              "string",
              "null"
            ]
          },
          "elm327_command_level": {
            "type": [
              "string",
              "null"
            ]
          },
          "stn_extensions": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "can_fd": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "j1979_2": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "iso_tp_long_messages": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "max_baud": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "detection": {
            "type": "object",
            "properties": {
              "ati_contains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "at1_contains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "at2_contains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sti_contains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "quirks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "uniqueItems": true
          },
          "verified": {
            "type": "boolean"
          },
          "checked": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
