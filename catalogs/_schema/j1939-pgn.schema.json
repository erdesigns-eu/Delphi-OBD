{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erdesigns.eu/schema/j1939-pgn.json",
  "title": "j1939-pgn",
  "type": "object",
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "spec": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "oem": {
      "type": "string"
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pgn",
          "name"
        ],
        "properties": {
          "pgn": {
            "type": "string",
            "pattern": "^(?:0x)?[0-9A-Fa-f]+$"
          },
          "mnemonic": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "length_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "default_priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "tx_rate_ms": {
            "type": "integer",
            "minimum": 0
          },
          "spec_section": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
